# HINLINK H28K (RK3528) 配置种子，build.sh 会先拷贝成 .config 再 make defconfig 补全。
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_h28k=y

# 分区：kernel 64MB / rootfs 2GB（板载 8GB eMMC，剩余留给 overlay 扩展）
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# 2GB 内存版本的抗压配置：zram 压缩内存当 swap
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y

# 「宽带拨号」模式需要：pppd + PPPoE 插件 + 内核模块 + LuCI 协议支持
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# 中文 LuCI + 常用组件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
# 网络向导：主路由/旁路由一键切换 + LAN IP / DHCP 配置（kit 自带 package）
CONFIG_PACKAGE_luci-app-netmode=y

# ImmortalWrt 官方默认的升级工具（manifest 里有，之前漏选）
CONFIG_PACKAGE_owut=y

# 基础运维 / USB 相关
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
# WireGuard：内核模块 + 工具 + LuCI 协议（对端管理/二维码由 luci-proto-wireguard 提供）
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_openssh-sftp-server=y
