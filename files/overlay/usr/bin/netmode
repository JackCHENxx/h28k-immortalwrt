#!/bin/sh
. /lib/functions.sh 2>/dev/null
# H28K 主路由 / 旁路由 一键切换
#
# 用法：
#   netmode status                 查看当前模式与关键配置
#   netmode bypass [主路由IP]      切旁路由（不填则用配置里的 upstream，默认 192.168.2.254）
#   netmode router                 切回主路由
#   netmode lanip <IP>             改本机 LAN IP（改完要用新地址重连）
#   netmode dhcp on|off            开/关本机 DHCP（旁路由模式下应关）
#
# 旁路由模式做的事：关本机 DHCP/RA、LAN 网关和 DNS 指向主路由、禁用 WAN、给 LAN 开 NAT。
# 客户端只要把网关/DNS 指向本机 LAN IP 就能借道出海，主路由不用动。

CONF=netmode
DEFAULT_UPSTREAM=192.168.2.254

lan_ip()   { uci -q get network.lan.ipaddr 2>/dev/null || echo "未知"; }
upstream() {
	local u
	u=$(uci -q get ${CONF}.@mode[0].upstream 2>/dev/null)
	[ -n "$u" ] && echo "$u" || echo "$DEFAULT_UPSTREAM"
}

ensure_conf() {
	# 兼容旧版本：曾用 h28k 作为配置名，自动迁移一份
	if [ ! -f /etc/config/$CONF ] && [ -f /etc/config/h28k ]; then
		cp /etc/config/h28k /etc/config/$CONF
	fi
	[ -f /etc/config/$CONF ] || touch /etc/config/$CONF
	if ! uci -q get ${CONF}.@mode[0] >/dev/null 2>&1; then
		uci -q set ${CONF}.mode=mode
		uci -q set ${CONF}.@mode[0].mode='router'
	fi
}

zone_idx() {
	local i=0 name
	while name=$(uci -q get firewall.@zone[$i].name); do
		if [ "$name" = "$1" ]; then echo "$i"; return 0; fi
		i=$((i + 1))
		[ $i -ge 20 ] && break
	done
	echo ""
}

lan_zone_idx() { zone_idx lan; }

wan_dev() { uci -q get network.wan.device 2>/dev/null; }

# 判断两个地址是否在同一子网（按掩码逐段比较，非 255 的段不比较）
same_subnet() {
	awk -v a="$1" -v b="$2" -v m="$3" 'BEGIN {
		split(a, A, "."); split(b, B, "."); split(m, M, ".")
		p = 0
		for (i = 1; i <= 4; i++) {
			v = M[i] + 0
			while (v > 0) { p += v % 2; v = int(v / 2) }
		}
		base = 2 ^ (32 - p)
		na = 0; nb = 0
		for (i = 1; i <= 4; i++) { na = na * 256 + A[i]; nb = nb * 256 + B[i] }
		exit (int(na / base) == int(nb / base)) ? 0 : 1
	}'
}

is_ipv4() {
	[ -n "$1" ] || return 1
	echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	echo "$1" | awk -F. '{ for (i = 1; i <= 4; i++) if ($i > 255) exit 1 }'
}

# 确保 lan -> wan 的 forwarding 存在（默认配置有，但可能被改掉）
ensure_forward() {
	local i=0 sec src dst
	while sec=$(uci -q get firewall.@forwarding[$i]); do
		src=$(uci -q get firewall.@forwarding[$i].src)
		dst=$(uci -q get firewall.@forwarding[$i].dest)
		[ "$src" = "$1" ] && [ "$dst" = "$2" ] && return 0
		i=$((i + 1))
	done
	sec=$(uci add firewall forwarding)
	uci -q set firewall.$sec.src="$1"
	uci -q set firewall.$sec.dest="$2"
}

reload_all() {
	/etc/init.d/network reload >/dev/null 2>&1
	/etc/init.d/firewall reload >/dev/null 2>&1
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	/etc/init.d/odhcpd restart >/dev/null 2>&1
}

cmd_status() {
	local idx
	idx=$(lan_zone_idx)
	echo "====== 当前网络模式（$(board_name 2>/dev/null || echo unknown)）======"
	echo "模式       : $(uci -q get ${CONF}.@mode[0].mode || echo '未设置')"
	echo "LAN IP     : $(lan_ip)"
	echo "主路由     : $(upstream)"
	echo "LAN 网关   : $(uci -q get network.lan.gateway || echo '无')"
	echo "LAN DNS    : $(uci -q get network.lan.dns || echo '无')"
	echo "DHCPv4     : $([ "$(uci -q get dhcp.lan.ignore)" = "1" ] && echo '关闭' || echo '开启')"
	echo "RA/DHCPv6  : $(uci -q get dhcp.lan.ra || echo 'server')"
	echo "WAN 口     : $([ "$(uci -q get network.wan.disabled)" = "1" ] && echo '已禁用' || echo '启用')"
	if wg show wg0 >/dev/null 2>&1; then
		port=$(wg show wg0 | awk '/listening port/{print $3}')
		echo "WireGuard  : 已启用（UDP ${port:-51820}）"
	else
		echo "WireGuard  : 未启用"
	fi
	[ -n "$idx" ] && echo "LAN NAT    : $(uci -q get firewall.@zone[$idx].masq || echo '0')"
}

cmd_bypass() {
	local up idx
	ensure_conf
	up="${1:-$(upstream)}"
	uci -q set ${CONF}.@mode[0].mode='bypass'
	uci -q set ${CONF}.@mode[0].upstream="$up"

	uci -q set dhcp.lan.ignore='1'
	uci -q set dhcp.lan.dhcpv6='disabled'
	uci -q set dhcp.lan.ra='disabled'

	uci -q set network.lan.gateway="$up"
	uci -q set network.lan.dns="$up"
	[ -n "$(uci -q get network.wan)" ] && uci -q set network.wan.disabled='1'
	[ -n "$(uci -q get network.wan6)" ] && uci -q set network.wan6.disabled='1'

	idx=$(zone_idx lan)
	[ -n "$idx" ] && {
		# 旁路由的流量从 LAN 口进、再从 LAN 口出去：需要 lan zone 自身允许 forward，
		# 并对 LAN 侧做 SNAT，保证回程也经过本机
		uci -q set firewall.@zone[$idx].forward='ACCEPT'
		uci -q set firewall.@zone[$idx].masq='1'
	}

	uci -q commit network
	uci -q commit dhcp
	uci -q commit firewall
	uci -q commit ${CONF}
	reload_all

	echo "已切换为【旁路由】模式"
	echo "  本机地址 : $(lan_ip)   （只做网关，不再发 DHCP）"
	echo "  上游主路由: $up"
	echo "接下来把主路由 DHCP 下发的 网关/DNS 指向 $(lan_ip) 即可；本机后台仍用 http://$(lan_ip) 访问。"
}

cmd_router() {
	local idx wz
	ensure_conf
	uci -q set ${CONF}.@mode[0].mode='router'

	uci -q set dhcp.lan.ignore='0'
	uci -q set dhcp.lan.dhcpv6='server'
	uci -q set dhcp.lan.ra='server'

	uci -q delete network.lan.gateway
	uci -q delete network.lan.dns
	[ -n "$(uci -q get network.wan)" ] && uci -q set network.wan.disabled='0'
	[ -n "$(uci -q get network.wan6)" ] && uci -q set network.wan6.disabled='0'

	idx=$(zone_idx lan)
	[ -n "$idx" ] && uci -q set firewall.@zone[$idx].masq='0'
	wz=$(zone_idx wan)
	[ -n "$wz" ] && uci -q set firewall.@zone[$wz].masq='1'
	ensure_forward lan wan

	uci -q commit network
	uci -q commit dhcp
	uci -q commit firewall
	uci -q commit ${CONF}
	reload_all

	echo "已切换为【主路由】模式：DHCP 已开、WAN 已启用、LAN 网关/DNS 已清空"
}

cmd_lanip() {
	[ -n "$1" ] || { echo "用法: netmode lanip <IP>"; exit 1; }
	is_ipv4 "$1" || { echo "错误: $1 不是合法的 IPv4 地址"; exit 1; }
	uci -q set network.lan.ipaddr="$1"
	uci -q commit network
	/etc/init.d/network reload >/dev/null 2>&1
	echo "LAN IP 已设为 $1，请用新地址重新访问（当前连接会断开）"
}

cmd_dhcp() {
	case "$1" in
		on)  uci -q set dhcp.lan.ignore='0' ;;
		off) uci -q set dhcp.lan.ignore='1' ;;
		*)   echo "用法: netmode dhcp on|off"; exit 1 ;;
	esac
	uci -q commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	/etc/init.d/odhcpd restart >/dev/null 2>&1
	echo "本机 DHCP 已$([ "$1" = "on" ] && echo 开启 || echo 关闭)"
}

# 探测可能的上级网关（旁路由向导预填用）
cmd_detect() {
	local gw
	gw=$(uci -q get network.lan.gateway 2>/dev/null)
	[ -n "$gw" ] || gw=$(ip -4 route show default 2>/dev/null | awk '/^default/{print $3; exit}')
	echo "$gw"
}

wizard_usage() {
	echo "用法: netmode setup bypass <主路由IP> [本机IP]"
	echo "      netmode setup dhcp [本机IP]"
	echo "      netmode setup pppoe <账号> <密码> [本机IP]"
}

# 向导后端：一次把 LAN IP / WAN / DHCP / NAT 配到位，供 LuCI 网络向导调用
cmd_setup() {
	local kind="$1" ip="" up=""

	case "$kind" in
		bypass)
			up="$2"; ip="$3"
			is_ipv4 "$up" || { echo "错误: 主路由地址不合法"; exit 1; }
			if [ -n "$ip" ]; then
				is_ipv4 "$ip" || { echo "错误: 本机地址不合法"; exit 1; }
				mask=$(uci -q get network.lan.netmask 2>/dev/null || echo 255.255.255.0)
				same_subnet "$up" "$ip" "$mask" \
					|| { echo "错误: 本机地址 $ip 与主路由 $up 不在同一网段（掩码 $mask）"; exit 1; }
				uci -q set network.lan.ipaddr="$ip"
			fi
			[ "$up" = "$(lan_ip)" ] && { echo "错误: 主路由地址不能是本机地址 $up"; exit 1; }
			cmd_bypass "$up"
			;;
		dhcp)
			ip="$2"
			if [ -n "$ip" ]; then
				is_ipv4 "$ip" || { echo "错误: 本机地址不合法"; exit 1; }
				uci -q set network.lan.ipaddr="$ip"
			fi
			ensure_conf
			uci -q set ${CONF}.@mode[0].mode='router'
			uci -q set network.wan.proto='dhcp'
			uci -q set network.wan.disabled='0'
			uci -q set network.wan.ipv6='1'
			[ -n "$(uci -q get network.wan6)" ] && uci -q set network.wan6.disabled='0'
			uci -q delete network.wan.username
			uci -q delete network.wan.password
			if [ -z "$(uci -q get network.wan6)" ]; then
				uci -q set network.wan6='interface'
				uci -q set network.wan6.proto='dhcpv6'
				uci -q set network.wan6.device='@wan'
			else
				uci -q set network.wan6.device='@wan'
			fi
			uci -q delete network.lan.gateway
			uci -q delete network.lan.dns
			uci -q set dhcp.lan.ignore='0'
			uci -q set dhcp.lan.dhcpv6='server'
			uci -q set dhcp.lan.ra='server'
			local lz wz
			lz=$(zone_idx lan); wz=$(zone_idx wan)
			[ -n "$lz" ] && uci -q set firewall.@zone[$lz].masq='0'
			[ -n "$wz" ] && uci -q set firewall.@zone[$wz].masq='1'
			ensure_forward lan wan
			uci -q commit network; uci -q commit dhcp; uci -q commit firewall; uci -q commit ${CONF}
			reload_all
			echo "已配置为【主路由 · WAN 自动获取】"
			echo "  WAN($(wan_dev)) : 从上级路由 DHCP 获取地址"
			echo "  本机地址   : $(lan_ip)"
			;;
		pppoe)
			[ -n "$2" ] && [ -n "$3" ] || { wizard_usage; exit 1; }
			ip="$4"
			if [ -n "$ip" ]; then
				is_ipv4 "$ip" || { echo "错误: 本机地址不合法"; exit 1; }
				uci -q set network.lan.ipaddr="$ip"
			fi
			ensure_conf
			uci -q set ${CONF}.@mode[0].mode='router'
			uci -q set network.wan.proto='pppoe'
			uci -q set network.wan.username="$2"
			uci -q set network.wan.password="$3"
			uci -q set network.wan.disabled='0'
			uci -q set network.wan.ipv6='1'
			[ -n "$(uci -q get network.wan6)" ] && uci -q set network.wan6.disabled='0'
			# 保证 wan6（IPv6CP/DHCPv6）挂在 pppoe 的 @wan 上
			if [ -z "$(uci -q get network.wan6)" ]; then
				uci -q set network.wan6='interface'
				uci -q set network.wan6.proto='dhcpv6'
				uci -q set network.wan6.device='@wan'
			else
				uci -q set network.wan6.device='@wan'
			fi
			uci -q delete network.lan.gateway
			uci -q delete network.lan.dns
			uci -q set dhcp.lan.ignore='0'
			uci -q set dhcp.lan.dhcpv6='server'
			uci -q set dhcp.lan.ra='server'
			local lz wz
			lz=$(zone_idx lan); wz=$(zone_idx wan)
			[ -n "$lz" ] && uci -q set firewall.@zone[$lz].masq='0'
			[ -n "$wz" ] && uci -q set firewall.@zone[$wz].masq='1'
			ensure_forward lan wan
			uci -q commit network; uci -q commit dhcp; uci -q commit firewall; uci -q commit ${CONF}
			reload_all
			echo "已配置为【主路由 · PPPoE 拨号】"
			echo "  宽带账号   : $2"
			echo "  本机地址   : $(lan_ip)"
			;;
		*)
			wizard_usage; exit 1
			;;
	esac
}

case "$1" in
	status) cmd_status ;;
	bypass) shift; cmd_bypass "$@" ;;
	router) cmd_router ;;
	lanip) shift; cmd_lanip "$@" ;;
	dhcp) shift; cmd_dhcp "$@" ;;
	detect) cmd_detect ;;
	setup) shift; cmd_setup "$@" ;;
	*) echo "用法: netmode [status|bypass [主路由IP]|router|lanip <IP>|dhcp on|off|detect|setup ...]"; exit 1 ;;
esac
